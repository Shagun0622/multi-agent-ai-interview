# Local development only. Copy to backend/.env and fill in values locally.
PORT=8000
FRONTEND_URL=http://localhost:5173
AUTH_MONGODB_URL=
RESUME_MONGODB_URL=
INTERVIEW_MONGODB_URL=
ROADMAP_MONGODB_URL=
BILLING_MONGODB_URL=
# Upstash ioredis TCP URL uses rediss://default:<TOKEN>@<HOST>:6379
REDIS_URL=
GROQ_API_KEY=
YOUTUBE_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Path relative to backend/ unless absolute. Keep the JSON file out of Git.
FIREBASE_SERVICE_ACCOUNT_PATH=./services/auth/serviceAccountKey.json
